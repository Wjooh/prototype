<div
  class="flex min-h-0 flex-1 flex-col"
  data-controller="day-selection"
>
  <header class="flex shrink-0 items-center justify-between border-b border-gray-200 bg-white px-6 py-3">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Orders</h1>
      <p class="text-sm text-gray-500"><%= @date.strftime("%A %-d %B %Y") %></p>
    </div>
    <button
      type="button"
      class="text-sm text-gray-500 hover:text-gray-800"
      data-action="day-selection#clear"
    >
      Clear selection
    </button>
  </header>

  <section class="min-h-0 flex-1 overflow-y-auto bg-white p-4">
    <div class="mx-auto max-w-2xl space-y-3">
      <% @orders.each do |order| %>
        <%= render "monitor_deliveries/order_card", order: order %>
      <% end %>
    </div>
  </section>
</div>
