<%
  hours = (@start_hour...@end_hour).to_a
  type_focus = %w[prep delivery].include?(@focus)
  dim_on = "grayscale opacity-20"
  dim_prep = ->(so) {
    return "" if @focus.nil?
    return @focus == "prep" ? "" : dim_on if type_focus
    so.order_id == @focus ? "" : dim_on
  }
  dim_delivery = ->(stop) {
    return "" if @focus.nil?
    return @focus == "delivery" ? "" : dim_on if type_focus
    stop.delivery.related_order_ids.include?(@focus) ? "" : dim_on
  }
  dim_connector = ->(c) {
    return "" if @focus.nil?
    return @focus == "delivery" ? "" : dim_on if type_focus
    (c.order_ids || []).include?(@focus) ? "" : dim_on
  }
%>

<div class="flex min-h-0 flex-1 flex-col" data-controller="timeline-drag">
  <header class="flex shrink-0 items-center justify-between gap-4 border-b border-gray-200 bg-white px-6 py-3">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Timeline</h1>
      <p class="text-sm text-gray-500"><%= @date.strftime("%A %-d %B %Y") %> · <%= @px_per_hour %>px / hour</p>
    </div>
    <div class="flex items-center gap-3 text-sm">
      <%
        focus_path = ->(kind) {
          monitor_timeline_path(@focus == kind ? {} : { focus: kind })
        }
      %>
      <%= link_to focus_path.call("prep"),
            class: "inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 #{@focus == "prep" ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-400"}" do %>
        <span class="inline-block size-3 rounded-sm border <%= @focus == "prep" ? "border-white bg-white" : "border-gray-300 bg-transparent" %>" aria-hidden="true"></span>
        Prep
      <% end %>
      <%= link_to focus_path.call("delivery"),
            class: "inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 #{@focus == "delivery" ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-400"}" do %>
        <span class="inline-block size-3 rounded-sm border <%= @focus == "delivery" ? "border-white bg-white" : "border-gray-300 bg-transparent" %>" aria-hidden="true"></span>
        Delivery
      <% end %>
      <span class="mx-1 h-5 w-px bg-gray-200" aria-hidden="true"></span>
      <% @graph.orders.each do |order| %>
        <%= link_to focus_path.call(order.id),
              title: order.customer_name,
              class: "inline-flex size-8 items-center justify-center rounded-full text-[10px] font-bold #{@focus == order.id ? "bg-gray-900 text-white ring-2 ring-gray-900 ring-offset-2" : "bg-gray-200 text-gray-500"}" do %>
          <%= order.avatar_initials %>
        <% end %>
      <% end %>
      <button
        type="button"
        data-action="timeline-drag#reset"
        class="rounded-md bg-gray-100 px-2.5 py-1.5 text-gray-700 hover:bg-gray-200"
      >Reset</button>
    </div>
  </header>

  <div class="min-h-0 flex-1 overflow-auto">
    <div class="min-w-max">
      <%# Hour ruler %>
      <div class="sticky top-0 z-20 flex border-b border-gray-200 bg-white">
        <div class="sticky left-0 z-30 w-52 shrink-0 border-r border-gray-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
          Location
        </div>
        <div class="relative h-10" style="width: <%= @timeline_width %>px">
          <% hours.each_with_index do |hour, i| %>
            <div
              class="absolute top-0 flex h-full items-end border-l border-gray-200 pb-2 pl-2 text-xs font-medium text-gray-500"
              style="left: <%= i * @px_per_hour %>px; width: <%= @px_per_hour %>px"
            >
              <%= format("%02d:00", hour) %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="relative">
        <%# Vertical hour grid %>
        <div class="pointer-events-none absolute inset-y-0 left-52" style="width: <%= @timeline_width %>px">
          <% hours.each_with_index do |_, i| %>
            <div
              class="absolute inset-y-0 border-l border-gray-100"
              style="left: <%= i * @px_per_hour %>px"
            ></div>
          <% end %>
        </div>

        <div
          class="relative"
          style="height: <%= @layout.total_height %>px"
          data-timeline-drag-target="canvas"
        >
          <svg
            class="pointer-events-none absolute left-52 top-0 z-[1] overflow-visible"
            style="width: <%= @timeline_width %>px; height: <%= @layout.total_height %>px"
            aria-hidden="true"
          >
            <% (@layout.connectors + @layout.so_connectors).each do |c| %>
              <%
                x1 = c.x1
                y1 = c.y1
                x2 = c.x2
                y2 = c.y2
                if x2 < x1
                  mid = (x1 + x2) / 2.0
                  x1 = mid
                  x2 = mid
                end
                stay = c.kind == :stay
              %>
              <path
                class="<%= stay ? "timeline-connector-stay" : "timeline-connector" %> <%= dim_connector.call(c) %>"
                data-timeline-drag-target="edge"
                data-from="<%= c.from_id %>"
                data-to="<%= c.to_id %>"
                <% if c.y2_from %>data-y2="from"<% end %>
                d="M <%= x1 %> <%= y1 %> C <%= x1 + (x2 - x1) / 2.0 %> <%= y1 %>, <%= x1 + (x2 - x1) / 2.0 %> <%= y2 %>, <%= x2 %> <%= y2 %>"
                fill="none"
                stroke="<%= stay ? "#d1d5db" : "#9ca3af" %>"
                stroke-width="1.5"
              />
            <% end %>
          </svg>

          <% @layout.lanes.each do |lane| %>
            <div class="absolute left-0 flex border-b border-gray-100" style="top: <%= lane.top %>px; height: <%= lane.height %>px; width: calc(13rem + <%= @timeline_width %>px)">
              <div class="sticky left-0 z-10 flex w-52 shrink-0 items-center gap-2 border-r border-gray-200 bg-white px-4">
                <% if lane.badge %>
                  <span
                    class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white"
                    style="background-color: <%= lane.color || "#4b5563" %>"
                  ><%= lane.badge %></span>
                <% end %>
                <p class="truncate text-xs font-medium text-gray-700"><%= lane.label %></p>
              </div>
              <div class="relative" style="width: <%= @timeline_width %>px; height: <%= lane.height %>px">
                <% lane.blocks.each do |block| %>
                  <% if block.kind == :prep %>
                    <% supplier_order = block.object %>
                    <div
                      id="prep-<%= supplier_order.id %>"
                      data-timeline-drag-target="block"
                      data-action="pointerdown->timeline-drag#grab pointermove->timeline-drag#move pointerup->timeline-drag#drop pointercancel->timeline-drag#drop"
                      class="absolute z-[2] cursor-grab touch-none rounded-xl border border-gray-200 bg-white p-3 shadow-sm active:cursor-grabbing <%= dim_prep.call(supplier_order) %>"
                      style="left: <%= block.left %>px; width: <%= block.width %>px; top: <%= block.top - lane.top %>px; height: <%= block.height %>px"
                      title="<%= supplier_order.label %> · prep <%= supplier_order.window_label %>"
                    >
                      <span class="absolute right-0 top-0 z-[1] rounded-bl-md rounded-tr-xl bg-gray-200 px-1.5 py-0.5 text-[11px] font-semibold leading-none text-gray-900"><%= supplier_order.prep_badge_label %></span>
                      <div class="flex h-16 flex-wrap content-start gap-2 overflow-hidden">
                        <% supplier_order.items.each do |item| %>
                          <div
                            class="relative flex h-16 w-16 shrink-0 items-center justify-center rounded-lg border border-gray-200 bg-white"
                            title="<%= item.product.name %>"
                          >
                            <span class="text-2xl leading-none" aria-hidden="true"><%= item.product.emoji %></span>
                            <span class="absolute right-0 top-0 rounded-bl-md rounded-tr-lg bg-gray-200 px-1.5 py-0.5 text-[11px] font-semibold leading-none text-gray-900">
                              <%= item.quantity %>
                            </span>
                            <span class="sr-only"><%= item.quantity %> × <%= item.product.name %></span>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% else %>
                    <% stop = block.object %>
                    <div
                      id="stop-<%= stop.delivery.id %>-<%= stop.position %>"
                      data-timeline-drag-target="block"
                      data-action="pointerdown->timeline-drag#grab pointermove->timeline-drag#move pointerup->timeline-drag#drop pointercancel->timeline-drag#drop"
                      class="absolute z-[2] flex cursor-grab touch-none items-center gap-2 overflow-hidden rounded-xl border border-gray-200 bg-white p-3 shadow-sm active:cursor-grabbing <%= dim_delivery.call(stop) %>"
                      style="left: <%= block.left %>px; width: <%= block.width %>px; top: <%= block.top - lane.top %>px; height: <%= block.height %>px"
                      title="<%= stop.label %> · <%= stop.kind_label %> <%= stop.time_label %>"
                    >
                      <span class="absolute right-0 top-0 z-[1] rounded-bl-md rounded-tr-xl bg-gray-200 px-1.5 py-0.5 text-[11px] font-semibold leading-none text-gray-900"><%= stop.pickup? ? "pickup" : "dropoff" %></span>
                      <% if stop.supplier? && stop.supplier %>
                        <span
                          class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold text-white"
                          style="background-color: <%= stop.supplier.color %>"
                        ><%= stop.supplier.name.first %></span>
                      <% elsif stop.hub? %>
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose-600 text-xs font-bold text-white">T</span>
                      <% else %>
                        <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gray-600 text-xs font-bold text-white">
                          <%= stop.order&.avatar_initials&.first || "C" %>
                        </span>
                      <% end %>
                      <div class="min-w-0">
                        <p class="truncate text-sm font-medium text-gray-900"><%= stop.label %></p>
                        <p class="truncate text-[11px] text-gray-400"><%= stop.kind_label %></p>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render "monitor_deliveries/scenario_graphs" %>
</div>
