<%
  start_minutes = @start_hour * 60
  hours = (@start_hour...@end_hour).to_a
%>

<%
  filter_params = ->(cook:, delivery:) {
    { cook: cook ? nil : "0", delivery: delivery ? nil : "0" }.compact
  }
%>

<div class="flex min-h-0 flex-1 flex-col">
  <header class="flex shrink-0 items-center justify-between gap-4 border-b border-gray-200 bg-white px-6 py-3">
    <div>
      <h1 class="text-base font-semibold text-gray-900">Timeline</h1>
      <p class="text-sm text-gray-500"><%= @date.strftime("%A %-d %B %Y") %> · <%= @px_per_hour %>px / hour</p>
    </div>
    <div class="flex items-center gap-3 text-sm">
      <%= link_to monitor_timeline_path(filter_params.call(cook: !@show_cook, delivery: @show_delivery)),
            class: "inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 #{@show_cook ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-400"}" do %>
        <span class="inline-block size-3 rounded-sm border <%= @show_cook ? "border-white bg-white" : "border-gray-300 bg-transparent" %>" aria-hidden="true"></span>
        Cook
      <% end %>
      <%= link_to monitor_timeline_path(filter_params.call(cook: @show_cook, delivery: !@show_delivery)),
            class: "inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 #{@show_delivery ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-400"}" do %>
        <span class="inline-block size-3 rounded-sm border <%= @show_delivery ? "border-white bg-white" : "border-gray-300 bg-transparent" %>" aria-hidden="true"></span>
        Delivery
      <% end %>
    </div>
  </header>

  <div class="min-h-0 flex-1 overflow-auto">
    <div class="min-w-max">
      <%# Hour ruler %>
      <div class="sticky top-0 z-20 flex border-b border-gray-200 bg-white">
        <div class="sticky left-0 z-30 w-52 shrink-0 border-r border-gray-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-wide text-gray-400">
          Slot
        </div>
        <div class="relative h-10" style="width: <%= @timeline_width %>px">
          <% hours.each_with_index do |hour, i| %>
            <div
              class="absolute top-0 flex h-full items-end border-l border-gray-200 pb-2 pl-2 text-xs font-medium text-gray-500"
              style="left: <%= i * @px_per_hour %>px; width: <%= @px_per_hour %>px"
            >
              <%= format("%02d:00", hour) %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="relative">
        <%# Vertical hour grid %>
        <div class="pointer-events-none absolute inset-y-0 left-52" style="width: <%= @timeline_width %>px">
          <% hours.each_with_index do |_, i| %>
            <div
              class="absolute inset-y-0 border-l border-gray-100"
              style="left: <%= i * @px_per_hour %>px"
            ></div>
          <% end %>
        </div>

        <div class="<%= @show_cook ? "" : "grayscale opacity-40" %>">
          <div class="sticky left-0 z-10 w-52 border-b border-gray-200 bg-gray-50 px-4 py-1.5 text-[10px] font-semibold uppercase tracking-wide text-gray-400">
            Prep · supplier orders
          </div>

          <% @supplier_orders.each do |supplier_order| %>
            <%
              left = ((supplier_order.window_start_minutes - start_minutes).to_f / 60) * @px_per_hour
              width = ((supplier_order.window_end_minutes - supplier_order.window_start_minutes).to_f / 60) * @px_per_hour
            %>
            <div class="relative flex border-b border-gray-100">
              <div class="sticky left-0 z-10 flex w-52 shrink-0 items-center gap-2 border-r border-gray-200 bg-white px-4 py-2">
                <% if supplier_order.supplier %>
                  <span
                    class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[9px] font-bold text-white"
                    style="background-color: <%= supplier_order.supplier.color %>"
                    title="<%= supplier_order.supplier.name %>"
                  ><%= supplier_order.supplier.name.first %></span>
                <% end %>
                <div class="min-w-0">
                  <p class="truncate text-xs font-medium text-gray-700"><%= supplier_order.supplier&.name %></p>
                  <p class="truncate text-[11px] text-gray-400"><%= supplier_order.order&.customer_name %></p>
                </div>
              </div>
              <div class="relative py-2" style="width: <%= @timeline_width %>px">
                <div
                  class="rounded-xl border border-gray-200 bg-white p-3 shadow-sm"
                  style="margin-left: <%= left %>px; width: <%= [width, 80].max %>px"
                  title="<%= supplier_order.label %> · prep <%= supplier_order.window_label %>"
                >
                  <p class="mb-2 text-center text-[11px] font-medium text-gray-500">Prep</p>
                  <div class="flex flex-wrap gap-2">
                    <% supplier_order.items.each do |item| %>
                      <div
                        class="relative flex h-16 w-16 items-center justify-center rounded-lg border border-gray-200 bg-white"
                        title="<%= item.product.name %>"
                      >
                        <span class="text-2xl leading-none" aria-hidden="true"><%= item.product.emoji %></span>
                        <span class="absolute -right-1.5 -top-1.5 flex h-5 min-w-5 items-center justify-center rounded-full bg-gray-200 px-1 text-[11px] font-semibold text-gray-900">
                          <%= item.quantity %>
                        </span>
                        <span class="sr-only"><%= item.quantity %> × <%= item.product.name %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="<%= @show_delivery ? "" : "grayscale opacity-40" %>">
          <div class="sticky left-0 z-10 w-52 border-b border-gray-200 bg-gray-50 px-4 py-1.5 text-[10px] font-semibold uppercase tracking-wide text-gray-400">
            Deliveries
          </div>

          <%
            stop_bar_h = 28
            stop_gap = 10
          %>
          <% @deliveries.each do |delivery| %>
            <%
              row_h = delivery.stops.size * stop_bar_h + (delivery.stops.size - 1) * stop_gap + 12
              stop_geometry = delivery.stops.map do |stop|
                left = ((stop.window_start_minutes - start_minutes).to_f / 60) * @px_per_hour
                width = ((stop.window_end_minutes - stop.window_start_minutes).to_f / 60) * @px_per_hour
                { stop: stop, left: left, width: [width, 24].max, right: left + [width, 24].max }
              end
            %>
            <div class="relative flex border-b border-gray-100" style="height: <%= row_h %>px">
              <div class="sticky left-0 z-10 flex w-52 shrink-0 flex-col justify-center gap-0.5 border-r border-gray-200 bg-white px-4">
                <p class="truncate text-xs font-medium text-gray-700"><%= delivery.kind_label %></p>
                <p class="truncate text-[11px] text-gray-400" title="<%= delivery.route_label %>"><%= delivery.route_label %></p>
              </div>
              <div class="relative" style="width: <%= @timeline_width %>px">
                <svg class="pointer-events-none absolute inset-0 h-full w-full overflow-visible" aria-hidden="true">
                  <% stop_geometry.each_cons(2).with_index do |(a, b), i| %>
                    <%
                      y1 = 6 + i * (stop_bar_h + stop_gap) + stop_bar_h / 2.0
                      y2 = 6 + (i + 1) * (stop_bar_h + stop_gap) + stop_bar_h / 2.0
                      x1 = a[:right]
                      x2 = b[:left]
                      # Overlapping windows: drop a vertical from mid-overlap
                      if x2 < x1
                        mid = (a[:left] + a[:right] + b[:left] + b[:right]) / 4.0
                        x1 = mid
                        x2 = mid
                      end
                    %>
                    <path
                      d="M <%= x1 %> <%= y1 %> C <%= x1 + (x2 - x1) / 2.0 %> <%= y1 %>, <%= x1 + (x2 - x1) / 2.0 %> <%= y2 %>, <%= x2 %> <%= y2 %>"
                      fill="none"
                      stroke="#9ca3af"
                      stroke-width="1.5"
                    />
                  <% end %>
                </svg>

                <% stop_geometry.each_with_index do |geo, i| %>
                  <% stop = geo[:stop] %>
                  <div
                    class="absolute flex items-center gap-1.5 overflow-hidden rounded-md bg-gray-900 px-2 text-[11px] font-medium text-white shadow-sm"
                    style="left: <%= geo[:left] %>px; width: <%= geo[:width] %>px; top: <%= 6 + i * (stop_bar_h + stop_gap) %>px; height: <%= stop_bar_h %>px"
                    title="<%= stop.label %> · <%= stop.kind_label %> <%= stop.time_label %>"
                  >
                    <% if stop.supplier? && stop.supplier %>
                      <span
                        class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[8px] font-bold text-white"
                        style="background-color: <%= stop.supplier.color %>"
                      ><%= stop.supplier.name.first %></span>
                    <% elsif stop.hub? %>
                      <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-rose-600 text-[8px] font-bold text-white">T</span>
                    <% else %>
                      <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-gray-600 text-[8px] font-bold text-white">
                        <%= stop.order&.avatar_initials&.first || "C" %>
                      </span>
                    <% end %>
                    <span class="truncate"><%= stop.label %></span>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%= render "monitor_deliveries/scenario_graphs" %>
</div>
