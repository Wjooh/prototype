<%# locals: (order:) %>
<article
  class="group cursor-pointer rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition
         data-[selected=true]:ring-2 data-[selected=true]:ring-gray-900
         data-[related=true]:bg-gray-50 data-[related=true]:ring-1 data-[related=true]:ring-gray-300
         data-[dimmed=true]:opacity-40"
  data-day-selection-target="order"
  data-order-id="<%= order.id %>"
  data-action="click->day-selection#selectOrder"
  data-selected="false"
  data-related="false"
  data-dimmed="false"
>
  <div class="flex items-start gap-3">
    <div
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gray-800 text-xs font-semibold text-white"
      aria-hidden="true"
    >
      <%= order.avatar_initials %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h3 class="text-sm font-semibold text-gray-900"><%= order.customer_name %></h3>
          <p class="text-xs text-gray-500"><%= order.slot_label %></p>
        </div>
        <div class="text-right">
          <p class="text-sm font-semibold text-gray-900"><%= order.total_label %></p>
          <p class="text-xs text-emerald-600"><%= order.margin_pct %>% margin</p>
        </div>
      </div>

      <div class="mt-3 flex items-center justify-between gap-2">
        <div class="flex -space-x-1">
          <% order.suppliers.each do |supplier| %>
            <span
              class="inline-flex h-6 w-6 items-center justify-center rounded-full border-2 border-white text-[10px] font-bold text-white"
              style="background-color: <%= supplier.color %>"
              title="<%= supplier.name %>"
            >
              <%= supplier.name.first %>
            </span>
          <% end %>
        </div>
        <p class="text-xs text-gray-500">Delivery <%= order.delivery_cost_label %></p>
      </div>
    </div>
  </div>

  <div class="mt-4 hidden space-y-3 border-t border-gray-100 pt-3 group-data-[selected=true]:block">
    <% order.supplier_orders.each do |supplier_order| %>
      <%= render "monitor_deliveries/item_row", supplier_order: supplier_order %>
    <% end %>
  </div>
</article>
