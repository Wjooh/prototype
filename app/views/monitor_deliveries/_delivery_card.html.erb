<%# locals: (delivery:) %>
<%
  status_class = case delivery.status
  when "complete" then "bg-emerald-100 text-emerald-800"
  when "in_progress" then "bg-amber-100 text-amber-900"
  else "bg-gray-100 text-gray-600"
  end
%>
<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
  <div class="mb-3 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="rounded-md bg-gray-900 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-white">
        <%= delivery.kind_label %>
      </span>
      <span class="rounded-md px-2 py-0.5 text-[11px] font-semibold <%= status_class %>">
        <%= delivery.status_label %>
      </span>
    </div>
    <span class="text-xs font-medium text-gray-500"><%= delivery.cost_label %></span>
  </div>


  <div class="flex flex-wrap items-start gap-2">
    <% delivery.stops.each_with_index do |stop, index| %>
      <% if index.positive? %>
        <span class="mt-2 text-gray-300" aria-hidden="true">→</span>
      <% end %>
      <div class="min-w-0">
        <div class="flex items-center gap-1.5">
          <% if stop.supplier? && stop.supplier %>
            <span
              class="inline-flex h-5 w-5 items-center justify-center rounded-full text-[9px] font-bold text-white"
              style="background-color: <%= stop.supplier.color %>"
            ><%= stop.supplier.name.first %></span>
          <% elsif stop.hub? %>
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-rose-600 text-[9px] font-bold text-white">T</span>
          <% else %>
            <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-gray-700 text-[9px] font-bold text-white">
              <%= stop.order&.avatar_initials&.first || "C" %>
            </span>
          <% end %>
          <p class="text-sm font-medium text-gray-900"><%= stop.label %></p>
        </div>
        <% if stop.tracking_label.present? %>
          <p class="mt-0.5 pl-6 text-[11px] text-gray-400"><%= stop.tracking_label %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</article>
