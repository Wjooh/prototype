<div class="flex min-h-0 flex-1 flex-col">
  <header class="shrink-0 border-b border-gray-200 bg-white px-6 py-3">
    <h1 class="text-base font-semibold text-gray-900">Deliveries</h1>
    <p class="text-sm text-gray-500"><%= @date.strftime("%A %-d %B %Y") %> · now <%= @now_hm %></p>
  </header>

  <section class="min-h-0 flex-1 overflow-y-auto bg-gray-50 p-4">
    <div class="mx-auto max-w-2xl space-y-3">
      <% @deliveries.each do |delivery| %>
        <%= render "monitor_deliveries/delivery_card", delivery: delivery %>
      <% end %>
    </div>
  </section>

  <%= render "monitor_deliveries/scenario_graphs" %>
</div>
