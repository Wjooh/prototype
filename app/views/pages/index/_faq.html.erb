<section class="bg-gray-50 px-4 py-10 md:px-6 md:py-14">
  <div class="mx-auto max-w-2xl">
    <h2 class="mb-6 text-center text-xl font-bold text-gray-800 md:mb-8 md:text-2xl">
      Frequently Asked Questions
    </h2>
    <div class="space-y-3">
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-4 md:px-6">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm text-gray-600 md:text-base">How far in advance should I order?</span>
          <%= heroicon "chevron-down", options: { class: "h-5 w-5 shrink-0 text-gray-400" } %>
        </div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-4 md:px-6">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm text-gray-600 md:text-base">Can I customize a pre-assembled bundle?</span>
          <%= heroicon "chevron-down", options: { class: "h-5 w-5 shrink-0 text-gray-400" } %>
        </div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-4 md:px-6">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm text-gray-600 md:text-base">What areas do you deliver to?</span>
          <%= heroicon "chevron-down", options: { class: "h-5 w-5 shrink-0 text-gray-400" } %>
        </div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-4 md:px-6">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm text-gray-600 md:text-base">How do I track my order?</span>
          <%= heroicon "chevron-down", options: { class: "h-5 w-5 shrink-0 text-gray-400" } %>
        </div>
      </div>
      <div class="rounded-lg border border-gray-200 bg-white px-4 py-4 md:px-6">
        <div class="flex items-center justify-between gap-4">
          <span class="text-sm text-gray-600 md:text-base">What is your cancellation policy?</span>
          <%= heroicon "chevron-down", options: { class: "h-5 w-5 shrink-0 text-gray-400" } %>
        </div>
      </div>
    </div>
  </div>
</section>
