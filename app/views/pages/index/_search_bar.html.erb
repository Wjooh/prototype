<section class="border-y border-gray-200 bg-gray-50 py-4">
  <div class="container mx-auto flex items-center gap-2 px-4 md:px-6">
    <div class="flex h-10 flex-1 items-center gap-2 rounded-lg border border-gray-300 bg-white px-3 md:h-11">
      <%= heroicon "magnifying-glass", options: { class: "text-gray-400" } %>
      <span class="text-sm text-gray-400">Search products...</span>
    </div>
    <button type="button" class="flex h-10 shrink-0 items-center justify-center rounded-lg bg-gray-300 px-4 text-gray-600 md:h-11 md:px-5">
      <%= heroicon "magnifying-glass", variant: :mini, options: { class: "text-gray-600" } %>
    </button>
  </div>
</section>
