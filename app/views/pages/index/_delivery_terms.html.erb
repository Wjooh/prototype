<section id="delivery" class="border-t border-gray-200 bg-gray-50 py-10 md:py-14">
  <div class="container mx-auto px-4 md:px-6">
    <h2 class="mb-6 text-center text-xl font-bold text-gray-800 md:mb-8 md:text-2xl">Delivery</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4 md:gap-5">
      <article class="flex flex-col items-center rounded-lg border border-gray-200 bg-white p-5 text-center md:p-6">
        <%= heroicon "truck", options: { class: "mb-3 h-10 w-10 text-gray-400 md:h-12 md:w-12" } %>
        <h3 class="mb-1 text-sm font-semibold text-gray-800 md:text-base">Same-day delivery</h3>
        <p class="text-sm text-gray-500">Order by 2pm for evening delivery</p>
      </article>
      <article class="flex flex-col items-center rounded-lg border border-gray-200 bg-white p-5 text-center md:p-6">
        <%= heroicon "map-pin", options: { class: "mb-3 h-10 w-10 text-gray-400 md:h-12 md:w-12" } %>
        <h3 class="mb-1 text-sm font-semibold text-gray-800 md:text-base">Greater London</h3>
        <p class="text-sm text-gray-500">We deliver across the city and suburbs</p>
      </article>
      <article class="flex flex-col items-center rounded-lg border border-gray-200 bg-white p-5 text-center md:p-6">
        <%= heroicon "clock", options: { class: "mb-3 h-10 w-10 text-gray-400 md:h-12 md:w-12" } %>
        <h3 class="mb-1 text-sm font-semibold text-gray-800 md:text-base">2-hour window</h3>
        <p class="text-sm text-gray-500">Choose a slot that fits your event</p>
      </article>
      <article class="flex flex-col items-center rounded-lg border border-gray-200 bg-white p-5 text-center md:p-6">
        <%= heroicon "shield-check", options: { class: "mb-3 h-10 w-10 text-gray-400 md:h-12 md:w-12" } %>
        <h3 class="mb-1 text-sm font-semibold text-gray-800 md:text-base">Fresh & safe</h3>
        <p class="text-sm text-gray-500">Temperature-controlled packaging</p>
      </article>
    </div>
  </div>
</section>
