        { title: "Wine &\nCheese", price: "£26", gradient: "from-stone-500 to-amber-800" },
        { title: "Tapas\nEvening", price: "£22", gradient: "from-red-500 to-orange-600" },
        { title: "Pizza\nNight", price: "£14", gradient: "from-orange-400 to-red-600" },
        { title: "Sunday\nRoast", price: "£27", gradient: "from-yellow-600 to-amber-800" },
        { title: "Potluck\nPlus", price: "£18", gradient: "from-green-500 to-emerald-700" }
