<section class="px-4 py-10 md:px-6 md:py-14">
  <div class="mx-auto max-w-7xl">
    <div class="mb-8 text-center md:mb-10">
      <h2 class="text-xl font-bold text-gray-800 md:text-2xl">Or choose a pre-assembled option</h2>
      <p class="mt-2 text-sm text-gray-500">Ready-made bundles for every occasion</p>
    </div>

    <div class="mb-10 md:mb-12">
      <div class="mb-4 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-700 md:text-xl">What's On</h3>
        <span class="text-sm text-gray-400 underline">View All</span>
      </div>
      <div class="flex gap-3 overflow-x-auto pb-2 md:gap-4">
        <article class="w-36 shrink-0 rounded-lg border border-gray-200 bg-white md:w-44">
  <div class="aspect-video rounded-t-lg bg-gray-200"></div>
  <div class="p-3">
    <div class="mb-2 h-3 w-3/4 rounded bg-gray-300"></div>
    <div class="flex items-center justify-between">
      <div class="h-3 w-12 rounded bg-gray-400"></div>
      <%= heroicon "arrow-right", variant: :mini, options: { class: "text-gray-500" } %>
    </div>
  </div>
</article>
