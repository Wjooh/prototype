<% sections = [
  { title: "Food & Drinks", filters: %w[All Pizza Sushi Salads Drinks Desserts] },
  { title: "Party Cakes", filters: %w[All Birthday Wedding Kids Custom] },
  { title: "Decor & Mood", filters: %w[All Balloons Flowers Tableware Lighting] }
] %>

<% sections.each do |section| %>
  <section class="py-10 md:py-14">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="mb-4 text-xl font-bold text-gray-800 md:mb-6 md:text-2xl"><%= section[:title] %></h2>
      <div class="scrollbar-hide mb-6 flex gap-2 overflow-x-auto pb-2 md:mb-8 md:flex-wrap md:gap-3">
        <% section[:filters].each_with_index do |filter, index| %>
          <span class="shrink-0 rounded-full px-4 py-1.5 text-sm <%= index.zero? ? "bg-gray-400 text-white" : "bg-gray-200 text-gray-600" %>"><%= filter %></span>
        <% end %>
      </div>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4 lg:grid-cols-6">
        <% 12.times do %>
          <%= render "pages/product_card" %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
