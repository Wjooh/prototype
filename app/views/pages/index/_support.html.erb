<section class="px-4 py-10 md:px-6 md:py-14">
  <div class="mx-auto max-w-md">
    <h2 class="mb-6 text-center text-xl font-bold text-gray-800 md:mb-8 md:text-2xl">Support Team</h2>
    <div class="space-y-3">
      <button type="button" class="flex w-full items-center justify-center gap-3 rounded-lg border border-gray-300 bg-gray-100 py-4 text-gray-600 md:py-5">
        <%= heroicon "chat-bubble-left-right", options: { class: "h-8 w-8 text-gray-500" } %>
        <span class="font-medium">WhatsApp</span>
      </button>
      <button type="button" class="flex w-full items-center justify-center gap-3 rounded-lg border border-gray-300 bg-gray-100 py-4 text-gray-600 md:py-5">
        <%= heroicon "chat-bubble-left", options: { class: "h-8 w-8 text-gray-500" } %>
        <span class="font-medium">Messenger</span>
      </button>
      <button type="button" class="flex w-full items-center justify-center gap-3 rounded-lg border border-gray-300 bg-gray-100 py-4 text-gray-600 md:py-5">
        <%= heroicon "envelope", options: { class: "h-8 w-8 text-gray-500" } %>
        <span class="font-medium">Email</span>
      </button>
    </div>
  </div>
</section>
