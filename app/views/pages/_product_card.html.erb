<%# locals: (title: nil, price: nil, image_url: nil, kids: nil, corporate: nil, weddings: nil) %>
<% kids = local_assigns.fetch(:kids, false) %>
<% corporate = local_assigns.fetch(:corporate, false) %>
<% weddings = local_assigns.fetch(:weddings, false) %>
<article class="w-full">
  <div class="relative overflow-hidden rounded-2xl">
    <a href="#" class="relative block aspect-[3/4]">
      <% if image_url.present? %>
        <div
          class="absolute inset-0 bg-cover bg-center"
          style="background-image: url('<%= image_url %>')"
          role="img"
          aria-label="<%= title %>"
        ></div>
      <% else %>
        <div class="absolute inset-0 bg-gray-200" aria-hidden="true"></div>
      <% end %>

      <span class="absolute bottom-2.5 left-2.5 rounded-full bg-white px-3 py-1.5 text-xs font-medium text-gray-800">
        Add to cart
      </span>
    </a>

    <% if kids || corporate || weddings %>
      <div class="absolute left-2.5 top-2.5 z-10 flex flex-col items-start gap-1">
        <% if kids %>
          <span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-medium text-gray-600 shadow-sm">Kids</span>
        <% end %>
        <% if corporate %>
          <span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-medium text-gray-600 shadow-sm">Corporate</span>
        <% end %>
        <% if weddings %>
          <span class="rounded-full bg-white px-2 py-0.5 text-[10px] font-medium text-gray-600 shadow-sm">Weddings</span>
        <% end %>
      </div>
    <% end %>

    <a
      href="#"
      class="absolute right-2.5 top-2.5 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white"
      aria-label="Add to favourites"
    >
      <%= heroicon "heart", options: { class: "text-gray-800" } %>
    </a>
  </div>

  <% if title.present? %>
    <p class="mt-2 text-sm font-medium leading-snug text-gray-800 whitespace-pre-line"><%= title %></p>
  <% end %>
</article>
