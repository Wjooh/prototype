<button
  type="button"
  data-cart-modal-target="fab"
  data-action="cart-modal#open"
  class="fixed right-4 z-50 flex h-14 w-14 cursor-pointer items-center justify-center rounded-full border border-gray-100 bg-white text-gray-800 shadow-[0_4px_24px_rgba(0,0,0,0.12)] transition-transform active:scale-95 bottom-[max(5.5rem,env(safe-area-inset-bottom))] aria-hidden:hidden md:hidden"
  aria-hidden="false"
  aria-label="Cart"
>
  <%= heroicon "shopping-cart", options: { class: "h-6 w-6" } %>
  <span class="absolute -right-0.5 -top-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-red-500 text-[10px] font-semibold text-white">2</span>
</button>
