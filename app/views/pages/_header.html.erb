<header class="shrink-0 border-b border-gray-200 bg-white" data-controller="mobile-menu">
  <div class="container mx-auto px-4 py-3 md:px-6 md:py-4">
    <%# Mobile top bar: burger left, utility icons right %>
    <div class="flex items-center justify-between md:hidden">
      <button
        type="button"
        data-action="mobile-menu#open"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-gray-200 text-gray-600"
        aria-label="Menu"
      >
        <%= heroicon "bars-3" %>
      </button>

      <div class="flex items-center gap-1.5">
        <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 text-gray-600" aria-label="Search">
          <%= heroicon "magnifying-glass" %>
        </button>
        <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 text-gray-600" aria-label="Favourites">
          <%= heroicon "heart" %>
        </button>
      </div>
    </div>

    <%# Desktop top row: Trustpilot left, utility pills right %>
    <div class="hidden flex-wrap items-center justify-between gap-3 md:flex">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-500 md:text-sm">
        <span class="flex gap-0.5" aria-hidden="true">
          <% 5.times do %>
            <%= heroicon "star", variant: :solid, options: { class: "text-gray-300" } %>
          <% end %>
        </span>
        Trustpilot
      </span>

      <div class="flex flex-wrap items-center justify-end gap-2 md:gap-2.5">
        <span class="inline-flex min-w-[10rem] items-center gap-2 rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-400 md:min-w-[14rem] md:px-4 md:text-sm">
          <%= heroicon "magnifying-glass", options: { class: "text-gray-300" } %>
          Search for a party cake
        </span>
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-gray-200 text-gray-600 md:h-9 md:w-9" aria-label="Favourites">
          <%= heroicon "heart" %>
        </span>
        <button type="button" data-action="cart-modal#open" class="relative inline-flex cursor-pointer items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 md:text-sm">
          <%= heroicon "shopping-cart" %>
          £394.94
          <span class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-gray-400 text-[10px] font-medium text-white">2</span>
        </button>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 md:px-4 md:text-sm">
          <%= heroicon "user" %>
          Sign In
        </span>
      </div>
    </div>

    <%# Logo — no background %>
    <div class="mt-4 text-center md:mt-5">
      <%= link_to root_path, class: "text-2xl font-bold tracking-wider text-gray-600 md:text-3xl" do %>
        TADAAA!
      <% end %>
    </div>

    <%= render "pages/nav" %>
  </div>

  <%= render "pages/mobile_menu" %>
</header>
