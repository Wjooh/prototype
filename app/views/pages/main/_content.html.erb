<main class="min-w-0 flex-1 overflow-y-auto bg-white">
  <div class="<%= @category.present? ? "container mx-auto" : "" %> px-4 py-4 md:px-6 md:py-6">
    <% unless @category.present? %>
      <%# Mobile category pills (sidebar hidden on small screens) %>
      <div class="scrollbar-hide mb-6 flex gap-2 overflow-x-auto pb-2 lg:hidden">
        <% @subcategories.each do |subcategory| %>
          <a
            href="<%= subcategory_link(subcategory.category_slug, subcategory.slug, category: subcategory.category) %>"
            class="inline-flex shrink-0 rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600"
          >
            <%= subcategory.name %>
          </a>
        <% end %>
      </div>
    <% end %>

    <% if @category.present? %>
      <div class="mb-10 text-center md:mb-12">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 md:text-5xl">Find ideas for your next event</h1>
        <p class="mt-3 text-base text-gray-500 md:mt-4 md:text-lg">Food, drinks, decor - everything ready for your next event</p>
      </div>
    <% end %>

    <%# Category sections with subcategory product rows %>
    <div class="space-y-10 md:space-y-12">
      <% @nav_categories.each do |category| %>
        <% next unless category.has_items? %>

        <%= render "pages/category", category: category %>
      <% end %>
    </div>
  </div>

  <% if @category.present? %>
    <div class="container mx-auto px-4 md:px-6">
      <div class="mb-10 text-center md:mb-12">
        <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 md:text-4xl">Or select from catalog</h2>
      </div>
    </div>
    <%= render "pages/catalog_preview" %>
  <% end %>
</main>
