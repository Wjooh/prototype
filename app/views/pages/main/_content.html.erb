<main class="min-w-0 flex-1 overflow-y-auto bg-white">
  <div class="px-4 py-4 md:px-6 md:py-6">
    <%# Filters %>
    <div class="scrollbar-hide mb-6 flex gap-2 overflow-x-auto pb-2 md:mb-8 md:flex-wrap md:gap-3">
      <% @filters.each do |filter| %>
        <span class="shrink-0 rounded-full bg-gray-200 px-4 py-1.5 text-sm text-gray-600">
          <%= filter.name %>
        </span>
      <% end %>
    </div>

    <%# Mobile category pills (sidebar hidden on small screens) %>
    <div class="scrollbar-hide mb-6 flex gap-2 overflow-x-auto pb-2 lg:hidden">
      <% @subcategories.each do |subcategory| %>
        <a
          href="<%= subcategory_path(subcategory.category_slug, subcategory.slug) %>"
          class="inline-flex shrink-0 rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600"
        >
          <%= subcategory.name %>
        </a>
      <% end %>
    </div>

    <%# Category sections with subcategory product rows %>
    <div class="space-y-10 md:space-y-12">
      <% @nav_categories.each do |category| %>
        <% next if category.subcategories.empty? %>

        <div>
          <h2 class="mb-6 text-xl font-bold text-gray-900 md:mb-8 md:text-2xl"><%= category.name %></h2>
          <div class="space-y-8 md:space-y-10">
            <% category.subcategories.each do |subcategory| %>
              <%= render "pages/main/subcategory_section", subcategory: subcategory %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</main>
