<main class="min-w-0 flex-1 bg-white">
  <div class="<%= @category&.bundles? ? "container mx-auto" : "" %> px-4 py-4 md:px-6 md:py-6">
    <% if @category&.bundles? %>
      <div class="mb-10 text-center md:mb-12">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 md:text-5xl">Find ideas for your next event</h1>
        <p class="mt-3 text-base text-gray-500 md:mt-4 md:text-lg">Food, drinks, decor - everything ready for your next event</p>
      </div>
    <% elsif @category&.products? %>
      <h1 class="mb-6 hidden text-2xl font-bold text-gray-800 md:mb-8 md:block md:text-3xl"><%= @category.name %></h1>
    <% end %>

    <%# Category sections with subcategory product rows %>
    <% content_categories = @category&.products? ? [@category] : @nav_categories %>
    <div class="space-y-10 md:space-y-12">
      <% content_categories.each do |category| %>
        <% next unless category.has_items? %>

        <%= render "pages/category", category: category %>
      <% end %>
    </div>
  </div>

  <% if @category&.bundles? %>
    <div class="container mx-auto px-4 md:px-6">
      <div class="mb-10 text-center md:mb-12">
        <h2 class="text-2xl font-extrabold tracking-tight text-gray-900 md:text-4xl">Or select from catalog</h2>
      </div>
    </div>
    <%= render "pages/catalog_preview" %>
  <% end %>
</main>
