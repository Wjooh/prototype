<%# locals: (subcategory:) %>
<section id="<%= subcategory.slug %>" class="scroll-mt-4">
  <div class="mb-3 flex items-center justify-between">
    <h3 class="text-lg font-bold text-gray-800 md:text-xl"><%= subcategory.name %></h3>
    <% if subcategory.category_slug.present? %>
      <a href="<%= subcategory_path(subcategory.category_slug, subcategory.slug) %>" class="text-sm text-gray-400 hover:text-gray-600">All &gt;</a>
    <% else %>
      <span class="text-sm text-gray-400">All &gt;</span>
    <% end %>
  </div>

  <div class="scrollbar-hide flex gap-3 overflow-x-auto pb-2 md:gap-4">
    <% if subcategory.category.bundles? %>
      <% bundle = Bundle.find_by_subcategory_slug(subcategory.slug) %>
      <% bundle&.cards&.each do |card| %>
        <div class="w-40 shrink-0 md:w-48">
          <%= render "pages/product_card", **card.to_h %>
        </div>
      <% end %>
    <% elsif subcategory.category.products? %>
      <% product = Product.find_by_subcategory_slug(subcategory.slug) %>
      <% product&.items&.each do |item| %>
        <div class="w-40 shrink-0 md:w-48">
          <%= render "pages/product_card", **item.to_h %>
        </div>
      <% end %>
      <% if product.nil? %>
        <% 10.times do %>
          <div class="w-40 shrink-0 md:w-48">
            <%= render "pages/product_card" %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <% 10.times do %>
        <div class="w-40 shrink-0 md:w-48">
          <%= render "pages/product_card" %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
