<%# locals: (subcategory:) %>
<% grid_layout = @category&.slug == "kids" %>
<section id="<%= subcategory_anchor_id(subcategory.category_slug, subcategory.slug) %>" class="scroll-mt-4">
  <div class="mb-3 flex items-center justify-between">
    <% if subcategory.category_slug.present? %>
      <h3 class="text-lg font-bold text-gray-800 md:text-xl">
        <a href="<%= subcategory_link(subcategory.category_slug, subcategory.slug, category: subcategory.category) %>" class="hover:text-gray-600"><%= subcategory.name %></a>
      </h3>
    <% else %>
      <h3 class="text-lg font-bold text-gray-800 md:text-xl"><%= subcategory.name %></h3>
    <% end %>
    <% unless grid_layout %>
      <% if subcategory.category_slug.present? %>
        <a href="<%= subcategory_link(subcategory.category_slug, subcategory.slug, category: subcategory.category) %>" class="text-sm text-gray-400 hover:text-gray-600">All &gt;</a>
      <% else %>
        <span class="text-sm text-gray-400">All &gt;</span>
      <% end %>
    <% end %>
  </div>

  <% carousel_card_class = "w-40 shrink-0 md:w-48" unless grid_layout %>
  <div class="<%= grid_layout ? "grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-5 lg:grid-cols-4" : "scrollbar-hide flex gap-3 overflow-x-auto pb-2 md:gap-4" %>">
    <% if subcategory.category.bundles? %>
      <% Bundle.for_subcategory(subcategory).each do |bundle| %>
        <div class="<%= carousel_card_class %>">
          <%= render "pages/product_card", **bundle.to_h %>
        </div>
      <% end %>
    <% elsif subcategory.category.products? %>
      <% products = Product.for_subcategory(subcategory.slug) %>
      <% products.each do |product| %>
        <div class="<%= carousel_card_class %>">
          <%= render "pages/product_card", **product.to_h %>
        </div>
      <% end %>
      <% if products.empty? %>
        <% 10.times do %>
          <div class="<%= carousel_card_class %>">
            <%= render "pages/product_card" %>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <% 10.times do %>
        <div class="<%= carousel_card_class %>">
          <%= render "pages/product_card" %>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
