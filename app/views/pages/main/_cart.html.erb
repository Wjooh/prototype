<div
  data-cart-modal-target="backdrop"
  data-action="click->cart-modal#close"
  class="fixed inset-0 z-[55] bg-black/30 aria-hidden:hidden"
  aria-hidden="true"
></div>

<aside
  data-cart-modal-target="panel"
  class="fixed inset-x-0 bottom-0 z-[56] flex h-[95vh] max-h-[95vh] flex-col rounded-t-2xl border-t border-gray-200 bg-white shadow-xl transition-transform duration-300 aria-hidden:translate-y-full md:inset-x-auto md:inset-y-0 md:right-0 md:h-auto md:max-h-none md:w-72 md:aria-hidden:translate-x-full md:aria-hidden:translate-y-0 md:rounded-none md:border-l md:border-t-0 xl:w-80"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="cart-modal-title"
>
  <div class="flex items-center justify-between border-b border-gray-200 px-4 py-4">
    <h2 id="cart-modal-title" class="text-lg font-bold text-gray-800">My order</h2>
    <button
      type="button"
      data-action="cart-modal#close"
      class="inline-flex h-8 w-8 items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 hover:text-gray-700"
      aria-label="Close"
    >
      <%= heroicon "x-mark", options: { class: "h-5 w-5" } %>
    </button>
  </div>

  <div class="flex flex-1 flex-col items-center justify-center px-6 py-10 text-center">
    <div class="mb-4 flex h-20 w-20 items-center justify-center rounded-full bg-gray-100 text-gray-300">
      <%= heroicon "shopping-cart", options: { class: "h-10 w-10" } %>
    </div>
    <p class="text-sm font-medium text-gray-600">Your cart is empty</p>
    <p class="mt-1 text-sm text-gray-400">Why not add some items?</p>
  </div>

  <div class="border-t border-gray-200 p-4">
    <button
      type="button"
      class="w-full cursor-default rounded-full border border-gray-200 bg-gray-100 px-4 py-3 text-sm text-gray-400"
      disabled
    >
      Add something to cart
    </button>
  </div>
</aside>
