<div class="flex min-h-screen flex-col">
  <%= render "pages/header" %>

  <main class="flex-1 bg-white">
    <% @bundle_categories.each do |category| %>
      <% next if category.subcategories.empty? %>

      <%= render "pages/category", category: category, compact: true %>
    <% end %>

    <%= render "pages/catalog_preview" %>
  </main>
</div>
