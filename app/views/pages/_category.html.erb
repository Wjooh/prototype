<%# locals: (category:, compact: false) %>
<% if compact %>
  <% first_subcategory = category.subcategories_with_items.first || category.subcategories.first %>

  <section class="my-6">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="mb-2 text-xl font-bold text-gray-800 md:text-2xl">
        <a href="<%= product_category_path(category) %>" class="hover:text-gray-600"><%= category.name %></a>
      </h2>
      <div class="scrollbar-hide mb-2 flex gap-2 overflow-x-auto pb-2 md:flex-wrap md:gap-3">
        <% category.subcategories.each do |subcategory| %>
          <% active = subcategory == first_subcategory %>
          <% if active %>
            <span class="shrink-0 rounded-full bg-gray-400 px-4 py-1.5 text-sm text-white">
              <%= subcategory.name %>
            </span>
          <% else %>
            <a
              href="<%= subcategory_link(category.slug, subcategory.slug, category: category) %>"
              class="shrink-0 rounded-full bg-gray-200 px-4 py-1.5 text-sm text-gray-600 hover:bg-gray-300"
            >
              <%= subcategory.name %>
            </a>
          <% end %>
        <% end %>
      </div>
      <div class="scrollbar-hide flex gap-3 overflow-x-auto pb-2 md:gap-4">
        <% if category.bundles? %>
          <% Bundle.for_subcategory(first_subcategory).each do |bundle| %>
            <div class="w-40 shrink-0 md:w-48">
              <%= render "pages/product_card", **bundle.to_h %>
            </div>
          <% end %>
        <% else %>
          <% Product.for_subcategory(first_subcategory.slug).each do |product| %>
            <div class="w-40 shrink-0 md:w-48">
              <%= render "pages/product_card", **product.to_h %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% else %>
  <% subcategories_to_show = category.subcategories_with_items %>
  <% if subcategories_to_show.any? %>
    <div>
      <% unless @category == category %>
        <h2 class="mb-6 text-xl font-bold text-gray-900 md:mb-8 md:text-2xl">
          <a href="<%= product_category_path(category) %>" class="hover:text-gray-700"><%= category.name %></a>
        </h2>
      <% end %>
      <div class="space-y-8 md:space-y-10">
        <% subcategories_to_show.each do |subcategory| %>
          <%= render "pages/main/subcategory_section", subcategory: subcategory %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
