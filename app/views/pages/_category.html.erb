<%# locals: (category:, compact: false) %>
<% if compact %>
  <% first_subcategory = category.subcategories.first %>

  <section class="py-10 md:py-14">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="mb-4 text-xl font-bold text-gray-800 md:mb-6 md:text-2xl"><%= category.name %></h2>
      <div class="scrollbar-hide mb-6 flex gap-2 overflow-x-auto pb-2 md:mb-8 md:flex-wrap md:gap-3">
        <% category.subcategories.each do |subcategory| %>
          <% active = subcategory == first_subcategory %>
          <% if active %>
            <span class="shrink-0 rounded-full bg-gray-400 px-4 py-1.5 text-sm text-white">
              <%= subcategory.name %>
            </span>
          <% else %>
            <a
              href="<%= subcategory_path_with_params(category.slug, subcategory.slug) %>"
              class="shrink-0 rounded-full bg-gray-200 px-4 py-1.5 text-sm text-gray-600 hover:bg-gray-300"
            >
              <%= subcategory.name %>
            </a>
          <% end %>
        <% end %>
      </div>
      <div class="scrollbar-hide flex gap-3 overflow-x-auto pb-2 md:gap-4">
        <% Product.for_subcategory(first_subcategory.slug).each do |product| %>
          <div class="w-40 shrink-0 md:w-48">
            <%= render "pages/product_card", **product.to_h %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% else %>
  <%
    subcategories_to_show = category.subcategories.select do |subcategory|
      next true if @active_filter.blank?

      if subcategory.category.bundles?
        Bundle.for_subcategory(subcategory.slug, filter: @active_filter).any?
      elsif subcategory.category.products?
        Product.for_subcategory(subcategory.slug, filter: @active_filter).any?
      else
        false
      end
    end
  %>
  <% if subcategories_to_show.any? %>
    <div>
      <h2 class="mb-6 text-xl font-bold text-gray-900 md:mb-8 md:text-2xl"><%= category.name %></h2>
      <div class="space-y-8 md:space-y-10">
        <% subcategories_to_show.each do |subcategory| %>
          <%= render "pages/main/subcategory_section", subcategory: subcategory %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
