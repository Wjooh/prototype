<%
  nav_items = [
    { label: "Home", path: root_path, icon: "home", active: request.path == "/" },
    { label: "Parties", path: parties_path, icon: "sparkles", active: request.path.start_with?("/parties") },
    { label: "Kids", path: kids_path, icon: "gift", active: request.path.start_with?("/kids") },
    { label: "Corporate", path: corporate_path, icon: "building-office-2", active: request.path.start_with?("/corporate") },
    { label: "Catalog", path: catalog_path, icon: "squares-2x2", active: request.path.start_with?("/catalog") }
  ]
%>

<nav
  class="z-40 flex justify-center max-md:fixed max-md:inset-x-2 max-md:bottom-[max(1rem,env(safe-area-inset-bottom))] max-md:z-50 md:sticky md:top-0 md:px-6 md:pb-3 md:pt-4"
  aria-label="Main navigation"
>
  <div class="mx-auto flex w-full max-w-lg items-center justify-around rounded-full border border-gray-100 bg-white px-1 py-2 shadow-[0_4px_24px_rgba(0,0,0,0.12)] md:max-w-4xl md:justify-normal md:px-1 md:py-2">
    <% nav_items.each do |item| %>
      <%= link_to item[:path], class: "flex flex-col items-center justify-center gap-0.5 rounded-2xl px-2 py-1.5 max-md:w-auto md:w-1/5 md:shrink-0 md:flex-row md:gap-2 md:py-2.5 #{item[:active] ? "bg-gray-100 text-red-500" : "text-gray-800"}" do %>
        <%= heroicon item[:icon], options: { class: "h-5 w-5 shrink-0 #{item[:active] ? "text-red-500" : ""}" } %>
        <span class="text-[10px] font-medium md:text-sm"><%= item[:label] %></span>
      <% end %>
    <% end %>
  </div>
</nav>
