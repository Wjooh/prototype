<div class="fixed top-3 right-3 z-[60] md:hidden">
  <div
    class="flex rounded-full border border-gray-200 bg-white p-0.5 text-xs font-medium shadow-lg"
    role="group"
    aria-label="Layout preview mode"
  >
    <button
      type="button"
      data-layout-preview-target="mobileButton"
      data-action="layout-preview#setMobile"
      class="rounded-full bg-gray-800 px-3 py-1.5 text-white transition-colors"
      aria-pressed="true"
    >
      Mobile
    </button>
    <button
      type="button"
      data-layout-preview-target="appButton"
      data-action="layout-preview#setApp"
      class="rounded-full px-3 py-1.5 text-gray-500 transition-colors"
      aria-pressed="false"
    >
      App
    </button>
  </div>
</div>
