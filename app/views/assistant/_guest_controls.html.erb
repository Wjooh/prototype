<%= form_with url: assistant_path, method: :get, local: true,
  class: "mx-auto w-full max-w-lg space-y-4",
  data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
  <%= hidden_field_tag :party_type, @party_type %>
  <%= hidden_field_tag :step, 3 %>

  <% if @party_type == "kids" %>
    <%= hidden_field_tag :kids_age, @kids_age %>
    <%= hidden_field_tag :kids_gender, @kids_gender %>
  <% elsif @occasion %>
    <%= hidden_field_tag :occasion, @occasion.slug %>
  <% end %>

  <% case @party_type %>
  <% when "kids" %>
    <%= render "assistant/guest_counter", name: "kids_count", label: "Kids", value: @kids_count || 8, min: 1 %>
    <%= render "assistant/guest_counter", name: "adults_count", label: "Adults", value: @adults_count || 2, min: 0 %>

  <% when "adults" %>
    <div class="space-y-4">
      <%= render "assistant/guest_counter", name: "adults_count", label: "Adults", value: @adults_count || 10, min: 1 %>

      <div class="rounded-2xl border border-gray-200 bg-white px-5 py-4" data-controller="reveal">
        <div class="flex items-center justify-between gap-4">
          <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
            <%= check_box_tag "include_kids", "1", @include_kids,
              class: "h-5 w-5 shrink-0 rounded border-gray-300 text-gray-800 focus:ring-gray-400",
              data: { action: "reveal#toggle" } %>
            <span class="text-base font-medium text-gray-900 md:text-lg">There will be kids</span>
          </label>

          <div class="<%= @include_kids ? nil : "hidden" %> shrink-0" data-reveal-target="panel">
            <%= render "assistant/guest_counter",
              name: "kids_count",
              label: "Kids",
              value: @kids_count || 2,
              min: 1,
              bordered: false,
              show_label: false %>
          </div>
        </div>
      </div>
    </div>

  <% when "corporate" %>
    <%= render "assistant/guest_counter", name: "guests_count", label: "Guests", value: @guests_count || 20, min: 1 %>
  <% end %>
<% end %>
