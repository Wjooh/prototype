<%# locals: (name: "kids_gender", value: 1) %>
<%
  name = local_assigns.fetch(:name, "kids_gender")
  value = local_assigns.fetch(:value, 1)
  options = [
    { label: "Mostly boys", value: 0 },
    { label: "Boys and Girls", value: 1 },
    { label: "Mostly girls", value: 2 }
  ]
  labels_json = options.map { |o| o[:label] }.to_json
%>
<div
  class="rounded-2xl border border-gray-200 bg-white px-5 py-4"
  data-controller="slider"
>
  <label class="text-base font-medium text-gray-900 md:text-lg" for="<%= name %>">Gender</label>

  <div class="mt-3">
    <input
      type="range"
      name="<%= name %>"
      id="<%= name %>"
      min="0"
      max="2"
      step="1"
      value="<%= value %>"
      class="assistant-slider"
      data-slider-target="input"
      data-slider-labels='<%= labels_json %>'
      data-action="input->slider#update"
      aria-valuemin="0"
      aria-valuemax="2"
      aria-valuenow="<%= value %>"
    >
  </div>

  <p class="mt-2 text-center text-sm font-medium text-gray-500" data-slider-target="display">
    <%= options[value][:label] %>
  </p>
</div>
