<p class="text-center text-sm font-medium text-gray-400">Step 2</p>
<h1 class="mt-3 text-center text-2xl font-extrabold tracking-tight text-gray-900 md:text-4xl">
  What's the occasion?
</h1>
<p class="mt-3 text-center text-base text-gray-500 md:text-lg">
  Pick one so we can suggest the right vibe — or keep it casual
</p>

<%= form_with url: assistant_path, method: :get, local: true, class: "mx-auto mt-10 w-full max-w-2xl md:mt-14" do %>
  <%= hidden_field_tag :party_type, @party_type %>
  <%= hidden_field_tag :step, 3 %>

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4">
    <% @occasions.each do |occasion| %>
      <label class="group relative cursor-pointer">
        <%= radio_button_tag "occasion", occasion.slug, @occasion.slug == occasion.slug,
          class: "peer sr-only" %>
        <span class="flex min-h-16 items-center justify-center rounded-2xl border-2 border-gray-200 bg-white px-3 py-4 text-center text-sm font-semibold text-gray-900 transition peer-checked:border-gray-800 peer-checked:bg-gray-50 group-hover:border-gray-400 md:min-h-20 md:text-base">
          <%= occasion.name %>
        </span>
      </label>
    <% end %>
  </div>

  <div class="flex justify-center pt-8 sm:justify-end">
    <button
      type="submit"
      class="rounded-full bg-gray-800 px-8 py-3 text-sm font-semibold text-white transition hover:bg-gray-700"
    >
      Continue
    </button>
  </div>
<% end %>
