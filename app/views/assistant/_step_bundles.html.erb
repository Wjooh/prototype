<%
  subtitle = case @party_type
  when "kids"
    age_band = Bundle.age_band_for(@kids_age)
    gender_label = case @kids_gender
    when 0 then "mostly boys"
    when 2 then "mostly girls"
    else "a mixed group"
    end
    "Themes for #{age_band} parties with #{gender_label}"
  when "adults"
    "Ideas for #{@occasion&.name || "your occasion"}"
  when "corporate"
    "Ideas for #{@occasion&.name || "your format"}"
  else
    "Ready-made parties that fit"
  end

  empty_copy = case @party_type
  when "kids"
    "No matching parties yet — try a different age or gender mix."
  when "adults"
    "No matching parties yet — try a different occasion."
  when "corporate"
    "No matching parties yet — try a different format."
  else
    "No matching parties yet."
  end
%>

<h1 class="mt-3 text-center text-2xl font-extrabold tracking-tight text-gray-900 md:text-4xl">
  Parties that fit
</h1>
<p class="mt-3 text-center text-base text-gray-500 md:text-lg">
  <%= subtitle %>
</p>

<div class="mx-auto mt-10 max-w-lg md:mt-14">
  <p class="mb-3 text-center text-sm font-medium text-gray-500">How many guests?</p>
  <%= render "assistant/guest_controls" %>
</div>

<% if @bundles.any? %>
  <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:mt-14 md:gap-6 lg:grid-cols-4">
    <% @bundles.each do |bundle| %>
      <%= render "pages/product_card", **bundle.to_h %>
    <% end %>
  </div>
<% else %>
  <p class="mt-10 text-center text-base text-gray-500 md:mt-14">
    <%= empty_copy %>
  </p>
<% end %>
