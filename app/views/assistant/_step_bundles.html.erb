<%
  age_band = Bundle.age_band_for(@kids_age)
  gender_label = case @kids_gender
  when 0 then "mostly boys"
  when 2 then "mostly girls"
  else "a mixed group"
  end
%>

<p class="text-center text-sm font-medium text-gray-400">Step 3</p>
<h1 class="mt-3 text-center text-2xl font-extrabold tracking-tight text-gray-900 md:text-4xl">
  Parties that fit
</h1>
<p class="mt-3 text-center text-base text-gray-500 md:text-lg">
  Themes for <%= age_band %> parties with <%= gender_label %>
</p>

<% if @bundles.any? %>
  <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 md:mt-14 md:gap-6 lg:grid-cols-4">
    <% @bundles.each do |bundle| %>
      <%= render "pages/product_card", **bundle.to_h %>
    <% end %>
  </div>
<% else %>
  <p class="mt-10 text-center text-base text-gray-500 md:mt-14">
    No matching parties yet — try a different age or gender mix.
  </p>
<% end %>
