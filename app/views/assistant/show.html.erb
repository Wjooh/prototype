<div class="flex min-h-screen flex-col">
  <%= render "pages/header" %>

  <main class="flex flex-1 flex-col bg-white">
    <div class="container mx-auto flex flex-1 flex-col px-4 py-8 md:px-6 md:py-12">
      <div class="mx-auto w-full max-w-4xl flex-1">
        <% if @step >= 2 %>
          <%
            back_path = if @step == 3 && (@party_type == "adults" || @party_type == "corporate")
              assistant_path(
                step: 2,
                party_type: @party_type,
                occasion: @occasion&.slug
              )
            elsif @step == 3
              assistant_path(
                step: 2,
                party_type: @party_type,
                kids_age: @kids_age,
                kids_gender: @kids_gender
              )
            else
              assistant_path
            end
          %>
          <div class="mb-6 md:mb-8">
            <%= link_to back_path, class: "inline-flex items-center gap-2 text-base font-medium text-gray-500 hover:text-gray-700 md:text-lg" do %>
              <%= heroicon "arrow-left", options: { class: "h-5 w-5 md:h-6 md:w-6" } %>
              Back
            <% end %>
          </div>
        <% end %>

        <% case @step %>
        <% when 3 %>
          <%= render "assistant/step_bundles" %>
        <% when 2 %>
          <% if @party_type == "adults" || @party_type == "corporate" %>
            <%= render "assistant/step_occasion" %>
          <% else %>
            <%= render "assistant/step_preferences" %>
          <% end %>
        <% else %>
          <%= render "assistant/step_party_type" %>
        <% end %>
      </div>
    </div>
  </main>
</div>
