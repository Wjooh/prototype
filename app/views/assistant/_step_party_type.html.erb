<h1 class="mt-3 text-center text-2xl font-extrabold tracking-tight text-gray-900 md:text-4xl">
  What type of party are you planning?
</h1>
<p class="mt-3 text-center text-base text-gray-500 md:text-lg">
  Pick one to get a bundle recommendation tailored to your event
</p>

<div class="mt-10 grid grid-cols-1 gap-4 md:mt-14 md:grid-cols-3 md:gap-6">
  <% @party_types.each do |party_type| %>
    <%= link_to assistant_path(step: 2, party_type: party_type[:key]),
      class: "group flex min-h-48 flex-col items-center justify-center gap-4 rounded-2xl border-2 border-gray-200 bg-white px-6 py-10 text-center transition hover:border-gray-400 hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-400 md:min-h-64 md:px-8 md:py-12" do %>
      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100 text-gray-700 transition group-hover:bg-gray-200 md:h-20 md:w-20">
        <%= heroicon party_type[:icon], options: { class: "h-8 w-8 md:h-10 md:w-10" } %>
      </span>
      <span class="block">
        <span class="block text-xl font-bold text-gray-900 md:text-2xl"><%= party_type[:label] %></span>
        <span class="mt-2 block text-sm text-gray-500 md:text-base"><%= party_type[:description] %></span>
      </span>
    <% end %>
  <% end %>
</div>
